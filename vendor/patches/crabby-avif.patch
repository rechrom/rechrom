+            dav1d_open(
+                Some(NonNull::from(&mut dec)),
+                Some(NonNull::from(&mut settings)),
+            )
+            .0
+        };
+        if ret != 0 {
+            return AvifError::unknown_error(format!("dav1d_open returned {ret}"));
+        }
