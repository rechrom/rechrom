+            unsafe { dav1d_close(Some(NonNull::from(&mut self.context))) };
+        }
+        self.context = None;
+    }
+
+    fn picture_to_image(
+        &self,
+        dav1d_picture: &Dav1dPicture,
+        image: &mut Image,
+        category: Category,
+        overwrite_alpha_plane_yuv_range: bool,
+    ) -> AvifResult<()> {
