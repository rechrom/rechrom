+            unsafe {
+                surface
+                    .0
+                    .unlock(IOSurfaceLockOptions::AvoidSync, std::ptr::null_mut());
+            }
+            return Err(error("unaligned IOSurface mapping"));
+        }
+        let mut mapping = Mapping {
+            surface,
+            _lease: lease,
+            ptr,
+            len,
+            row_stride: stride / 4,
+            locked: true,
+            retained: previous.is_some(),
+        };
